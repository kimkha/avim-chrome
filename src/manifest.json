{
  "name": "__MSG_extName__",
  "version": "0.10.0",
  "manifest_version": 3,
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_extAction__",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "js": [ "scripts/avim-ext.js" ],
    "matches": ["http://*/*", "https://*/*"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "default_locale": "en",
  "offline_enabled": true,
  "permissions": ["storage"],
  "background": {
    "service_worker": "chrome/background.js"
  }
}
